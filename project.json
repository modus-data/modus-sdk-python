{
  "name": "modus-sdk-python",
  "sourceRoot": "distribution/clients/python/modus-sdk",
  "projectType": "library",
  "tags": ["scope:sdk", "type:lib", "lang:python"],
  "implicitDependencies": ["modus-api", "agent-service", "openapi-portal"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/sdk-python/ensure-uv.sh sync --extra dev",
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "inputs": [
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{workspaceRoot}/scripts/sdk-python/ensure-uv.sh"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash -c 'mkdir -p reports && bash ../../../../scripts/sdk-python/ensure-uv.sh run pytest tests/ -v -m \"not integration\" --junit-xml=reports/pytest-junit.xml --tb=short'",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        "{workspaceRoot}/packages/openapi-portal/src/**/*.ts",
        "{workspaceRoot}/distribution/clients/python/scripts/**",
        "{workspaceRoot}/distribution/clients/sdk-surface.json",
        "{workspaceRoot}/distribution/clients/sdk-surface.schema.json"
      ],
      "outputs": ["{projectRoot}/reports"]
    },
    "test-staging-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash -c 'mkdir -p reports && bash ../../../../scripts/sdk-python/ensure-uv.sh run pytest tests/integration/test_staging_smoke.py -m integration -v --tb=short'",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash -c 'set -o pipefail; mkdir -p reports && bash ../../../../scripts/sdk-python/ensure-uv.sh run ruff check modus/ tests/ ../dev-examples/ 2>&1 | tee reports/ruff.log && bash ../../../../scripts/sdk-python/ensure-uv.sh run mypy modus/ 2>&1 | tee reports/mypy.log'",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        "{workspaceRoot}/packages/openapi-portal/src/**/*.ts"
      ],
      "outputs": ["{projectRoot}/reports"]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash ../../../../scripts/sdk-python/ensure-uv.sh build",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock", "default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "check-docstrings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash -c 'bash ../scripts/check-sdk-public-docstrings.sh && python3 ../scripts/check-generated-model-names.py && python3 ../scripts/check-sdk-docs-coverage.py'",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/modus/**/*.py",
        "{projectRoot}/modus/_generated/models.py",
        "{workspaceRoot}/distribution/clients/python/scripts/check-sdk-public-docstrings.sh",
        "{workspaceRoot}/distribution/clients/python/scripts/check-generated-model-names.py",
        "{workspaceRoot}/distribution/clients/python/scripts/check-sdk-docs-coverage.py"
      ]
    },
    "requirements-drift": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash scripts/check-snyk-requirements-drift.sh",
        "cwd": "{workspaceRoot}/distribution/clients/python"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/distribution/clients/python/**"]
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["modus-sdk-typescript"], "target": "generate-spec" },
        "install"
      ],
      "options": {
        "command": "bash ../../../../scripts/sdk-python/ensure-uv.sh run python ../scripts/generate-sdk-from-openapi.py",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "inputs": [
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        "{workspaceRoot}/packages/openapi-portal/src/**/*.ts",
        "{workspaceRoot}/distribution/clients/python/scripts/generate-sdk-from-openapi.py",
        "{workspaceRoot}/distribution/clients/python/scripts/emit-openapi-operations.py",
        "{workspaceRoot}/distribution/clients/python/scripts/emit_sdk_resources.py",
        "{workspaceRoot}/distribution/clients/sdk-surface.json"
      ],
      "outputs": ["{projectRoot}/modus/_generated/**"]
    },
    "contract-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "install",
        { "projects": ["openapi-portal"], "target": "build" },
        { "projects": ["modus-sdk-typescript"], "target": "contract-check" }
      ],
      "options": {
        "command": "bash distribution/clients/python/scripts/check-contract.sh",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        { "dependentTasksOutputFiles": "**/*.js" },
        "{workspaceRoot}/distribution/clients/python/scripts/**",
        "{workspaceRoot}/distribution/clients/sdk-surface.json",
        "{workspaceRoot}/distribution/clients/typescript/modus-sdk/src/_generated/public-openapi.json"
      ]
    },
    "sdk:check": {
      "executor": "nx:noop",
      "dependsOn": ["check-docstrings", "requirements-drift", "contract-check"]
    },
    "public-surface": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash ../../../../scripts/sdk-python/ensure-uv.sh run python ../scripts/emit_public_surface.py --write",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/tests/snapshots/public_surface.json"],
      "cache": false
    },
    "public-surface-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash ../../../../scripts/sdk-python/ensure-uv.sh run python ../scripts/emit_public_surface.py --check",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "openapi-impact": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash ../scripts/ci-openapi-sdk-impact.sh",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
