{
  "name": "modus-sdk",
  "sourceRoot": "sdk/python/modus-sdk",
  "projectType": "library",
  "tags": ["scope:sdk", "type:lib", "lang:python"],
  "implicitDependencies": ["modus-api"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/sdk-python/ensure-uv.sh sync --extra dev",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{workspaceRoot}/scripts/sdk-python/ensure-uv.sh"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash -c 'mkdir -p reports && bash ../../../scripts/sdk-python/ensure-uv.sh run pytest tests/ -v -m \"not integration\" --junit-xml=reports/pytest-junit.xml --tb=short'",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/modus-api/openapi/v1.json"
      ],
      "outputs": ["{projectRoot}/reports"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash -c 'set -o pipefail; mkdir -p reports && bash ../../../scripts/sdk-python/ensure-uv.sh run ruff check modus/ tests/ ../dev-examples/ 2>&1 | tee reports/ruff.log && bash ../../../scripts/sdk-python/ensure-uv.sh run mypy modus/ 2>&1 | tee reports/mypy.log'",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/modus-api/openapi/v1.json"
      ],
      "outputs": ["{projectRoot}/reports"]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash ../../../scripts/sdk-python/ensure-uv.sh build",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock", "default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "check-docstrings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ../scripts/check-sdk-public-docstrings.sh",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/modus/**/*.py",
        "{workspaceRoot}/sdk/python/scripts/check-sdk-public-docstrings.sh"
      ]
    },
    "requirements-drift": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "bash scripts/check-snyk-requirements-drift.sh",
        "cwd": "{workspaceRoot}/sdk/python"
      },
      "cache": false
    }
  }
}
