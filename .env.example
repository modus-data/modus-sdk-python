export MODUS_API_KEY=modus_xxx

# Local development: point directly at modus-api (port 3040).
# Do NOT use port 3080 — that is the dev proxy (LocalStack/Lambda mocks)
# which does not forward PAT tokens to the NestJS services.
# Local dev: source monorepo ports.env / .env.local-dev, then e.g.:
# export MODUS_BASE_URL="http://localhost:${MODUS_API_PORT}"
export MODUS_BASE_URL=https://api.modus.com

# Production:
# export MODUS_BASE_URL=https://api.modus.com
