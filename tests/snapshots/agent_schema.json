{
  "$defs": {
    "AgentAccessConfigDto": {
      "properties": {
        "visibility": {
          "$ref": "#/$defs/Visibility",
          "description": "Visibility tier. `shared` applies the group-permission map; `private` ignores groups and uses owner + sharedWith for access.",
          "examples": [
            "shared"
          ]
        },
        "groupPermissions": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentGroupPermissionDto"
          },
          "description": "Map of group UUID -> { use, manage } booleans. Empty object when visibility is `private`.",
          "examples": [
            {
              "group_eng_uuid": {
                "manage": false,
                "use": true
              }
            }
          ],
          "title": "Grouppermissions",
          "type": "object"
        },
        "sharedWith": {
          "description": "Per-user share entries used for private-visibility workflows.",
          "examples": [
            []
          ],
          "items": {
            "$ref": "#/$defs/AgentSharedUserDto"
          },
          "title": "Sharedwith",
          "type": "array"
        },
        "ownerUserId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clerk user id of the workflow owner. Set on first write for private workflows.",
          "examples": [
            "user_2abc"
          ],
          "title": "Owneruserid"
        },
        "ownerEmail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowercased email of the workflow owner. Used by private-workflow ACL when owner email matches.",
          "examples": [
            "alice@example.com"
          ],
          "title": "Owneremail"
        }
      },
      "required": [
        "visibility",
        "groupPermissions",
        "sharedWith"
      ],
      "title": "AgentAccessConfigDto",
      "type": "object"
    },
    "AgentDashboardAlertResponseDto": {
      "properties": {
        "dashboardId": {
          "description": "Id of the dashboard whose KPI alert generated this workflow.",
          "examples": [
            "dash_01j9z3k2"
          ],
          "title": "Dashboardid",
          "type": "string"
        },
        "tileId": {
          "description": "Id of the dashboard tile the alert watches.",
          "examples": [
            "tile_revenue"
          ],
          "title": "Tileid",
          "type": "string"
        }
      },
      "required": [
        "dashboardId",
        "tileId"
      ],
      "title": "AgentDashboardAlertResponseDto",
      "type": "object"
    },
    "AgentGroupPermissionDto": {
      "properties": {
        "use": {
          "description": "Whether members of this group may use (run / invoke) the workflow.",
          "examples": [
            true
          ],
          "title": "Use",
          "type": "boolean"
        },
        "manage": {
          "description": "Whether members of this group may manage (edit / deploy / delete) the workflow.",
          "examples": [
            false
          ],
          "title": "Manage",
          "type": "boolean"
        }
      },
      "required": [
        "use",
        "manage"
      ],
      "title": "AgentGroupPermissionDto",
      "type": "object"
    },
    "AgentSelectionEntryDto": {
      "properties": {
        "agentId": {
          "description": "Numeric scope (workflow) id to invoke at this step.",
          "examples": [
            17
          ],
          "minimum": 1.0,
          "title": "Agentid",
          "type": "number"
        },
        "priorityOrder": {
          "description": "Execution order (1-indexed).",
          "examples": [
            1
          ],
          "minimum": 1.0,
          "title": "Priorityorder",
          "type": "number"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional role label.",
          "examples": [
            "researcher"
          ],
          "title": "Role"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-step instructions added to the prompt.",
          "examples": [
            "Focus on the last 30 days of data"
          ],
          "title": "Instructions"
        },
        "toolRestrictions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional allowlist of tools the step may call.",
          "title": "Toolrestrictions"
        }
      },
      "required": [
        "agentId",
        "priorityOrder"
      ],
      "title": "AgentSelectionEntryDto",
      "type": "object"
    },
    "AgentSelectionResponseDto": {
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override model name for the orchestration step.",
          "title": "Model"
        },
        "modelSettings": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSettingsDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model-specific runtime controls such as reasoning effort and context window."
        },
        "agents": {
          "description": "Ordered list of scopes to invoke. Writes must contain at least one entry; a GET response may contain an empty list when the selection is cleared.",
          "items": {
            "$ref": "#/$defs/AgentSelectionEntryDto"
          },
          "title": "Agents",
          "type": "array"
        }
      },
      "required": [
        "agents"
      ],
      "title": "AgentSelectionResponseDto",
      "type": "object"
    },
    "AgentSharedUserDto": {
      "properties": {
        "email": {
          "description": "Lowercased email of a user explicitly granted access to a private workflow.",
          "examples": [
            "alice@example.com"
          ],
          "title": "Email",
          "type": "string"
        },
        "addedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-8601 timestamp at which this user was added to the share list.",
          "examples": [
            "2026-05-01T10:00:00Z"
          ],
          "title": "Addedat"
        },
        "addedBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clerk user id of the principal that added this share entry.",
          "examples": [
            "user_2abc"
          ],
          "title": "Addedby"
        },
        "userId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clerk user id of the invited principal (optional \u2014 email is the primary key).",
          "examples": [
            "user_2xyz"
          ],
          "title": "Userid"
        }
      },
      "required": [
        "email"
      ],
      "title": "AgentSharedUserDto",
      "type": "object"
    },
    "AgentType": {
      "enum": [
        "task",
        "workflow"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "AgentVariationDto": {
      "properties": {
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowTriggerResponseDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`trigger_type` is `schedule`, `webhook`, `api`, `slack`, or `manual`. `schedule` is present only for a schedule trigger. Null until a trigger is saved."
        },
        "workflowStructure": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowStructureResponseDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Workflow graph (`nodes` and `edges`) when `type` is `workflow`. Null when `type` is `task`."
        },
        "agentSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentSelectionResponseDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Selected scopes and per-step config (`agents`, optional `model`) when `type` is `task`. Null when `type` is `workflow`."
        }
      },
      "title": "AgentVariationDto",
      "type": "object"
    },
    "Frequency": {
      "enum": [
        "hourly",
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "ManageDenial": {
      "enum": [
        "not_owner",
        "needs_group_manage"
      ],
      "title": "ManageDenial",
      "type": "string"
    },
    "ModelSettingsDto": {
      "properties": {
        "reasoningEffort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional reasoning effort for models that support it."
        },
        "contextWindow": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Selected model context window in tokens.",
          "title": "Contextwindow"
        }
      },
      "title": "ModelSettingsDto",
      "type": "object"
    },
    "PendingOwnershipTransferDto": {
      "properties": {
        "pendingOwnerUserId": {
          "description": "Clerk user id of the org member who will become owner once they accept.",
          "examples": [
            "user_2abc123def456"
          ],
          "title": "Pendingowneruserid",
          "type": "string"
        },
        "pendingOwnerEmail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email of the pending recipient, resolved from org membership at request time.",
          "examples": [
            "newowner@example.com"
          ],
          "title": "Pendingowneremail"
        },
        "requestedByUserId": {
          "description": "Clerk user id of the member who requested the transfer (the current owner).",
          "examples": [
            "user_2xyz789ghi012"
          ],
          "title": "Requestedbyuserid",
          "type": "string"
        },
        "requestedAt": {
          "description": "When the transfer was requested.",
          "examples": [
            "2026-06-05T12:00:00.000Z"
          ],
          "title": "Requestedat",
          "type": "string"
        }
      },
      "required": [
        "pendingOwnerUserId",
        "requestedByUserId",
        "requestedAt"
      ],
      "title": "PendingOwnershipTransferDto",
      "type": "object"
    },
    "ReasoningEffort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "ResourceLifecycleStatus": {
      "enum": [
        "draft",
        "active",
        "deleted"
      ],
      "title": "ResourceLifecycleStatus",
      "type": "string"
    },
    "TriggerType": {
      "enum": [
        "schedule",
        "webhook",
        "api",
        "slack",
        "manual"
      ],
      "title": "TriggerType",
      "type": "string"
    },
    "Visibility": {
      "enum": [
        "shared",
        "private"
      ],
      "title": "Visibility",
      "type": "string"
    },
    "Weekday": {
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "title": "Weekday",
      "type": "string"
    },
    "WorkflowEdgeDto": {
      "properties": {
        "id": {
          "description": "Stable edge id, unique within the graph.",
          "examples": [
            "e1"
          ],
          "title": "Id",
          "type": "string"
        },
        "source": {
          "description": "Source node id.",
          "examples": [
            "1"
          ],
          "title": "Source",
          "type": "string"
        },
        "target": {
          "description": "Target node id.",
          "examples": [
            "2"
          ],
          "title": "Target",
          "type": "string"
        },
        "sourceHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source port handle (e.g. a condition branch). Omit for a single-output node.",
          "examples": [
            "branch_0"
          ],
          "title": "Sourcehandle"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "WorkflowEdgeDto",
      "type": "object"
    },
    "WorkflowNodeDto": {
      "properties": {
        "id": {
          "description": "Stable node id, unique within the graph.",
          "examples": [
            "1"
          ],
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/WorkflowNodeType",
          "description": "Node kind. Determines how the runtime interprets `data`.",
          "examples": [
            "start"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowNodePositionDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canvas position. Optional \u2014 preserved for builder layout when present."
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Node-type-specific payload (intentionally open \u2014 shape varies by `type`). Defaults to `{}`.",
          "examples": [
            {}
          ],
          "title": "Data"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "WorkflowNodeDto",
      "type": "object"
    },
    "WorkflowNodePositionDto": {
      "properties": {
        "x": {
          "examples": [
            0
          ],
          "title": "X",
          "type": "number"
        },
        "y": {
          "examples": [
            50
          ],
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "WorkflowNodePositionDto",
      "type": "object"
    },
    "WorkflowNodeType": {
      "enum": [
        "start",
        "action",
        "condition",
        "agent",
        "humanApproval"
      ],
      "title": "WorkflowNodeType",
      "type": "string"
    },
    "WorkflowStructureResponseDto": {
      "properties": {
        "nodes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WorkflowNodeDto"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Workflow nodes. Defaults to `[]`.",
          "title": "Nodes"
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WorkflowEdgeDto"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Directed edges connecting the nodes. Defaults to `[]`.",
          "title": "Edges"
        }
      },
      "title": "WorkflowStructureResponseDto",
      "type": "object"
    },
    "WorkflowTriggerResponseDto": {
      "properties": {
        "triggerType": {
          "$ref": "#/$defs/TriggerType",
          "description": "Trigger kind. Only `schedule` validates its nested payload here; the rest are opaque.",
          "examples": [
            "schedule"
          ]
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowTriggerScheduleResponseDto"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schedule details. Required when trigger_type=schedule. Null for every other trigger."
        }
      },
      "required": [
        "triggerType"
      ],
      "title": "WorkflowTriggerResponseDto",
      "type": "object"
    },
    "WorkflowTriggerScheduleResponseDto": {
      "properties": {
        "frequency": {
          "$ref": "#/$defs/Frequency",
          "description": "Cadence of the schedule.",
          "examples": [
            "daily"
          ]
        },
        "timeOfDay": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time of day in 24-hour HH:MM format. Required for hourly/daily/weekly/monthly; ignored for custom.",
          "examples": [
            "09:00"
          ],
          "title": "Timeofday"
        },
        "timezone": {
          "description": "IANA timezone identifier.",
          "examples": [
            "UTC"
          ],
          "title": "Timezone",
          "type": "string"
        },
        "weekdays": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Weekday"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for weekly schedules. Lowercase day names.",
          "examples": [
            [
              "monday",
              "wednesday",
              "friday"
            ]
          ],
          "title": "Weekdays"
        },
        "dayOfMonth": {
          "anyOf": [
            {
              "maximum": 31.0,
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for monthly schedules. Calendar day 1-31.",
          "examples": [
            15
          ],
          "title": "Dayofmonth"
        },
        "cronExpressions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for custom schedules. Each entry is a 5-field POSIX cron expression.",
          "examples": [
            [
              "0 9 * * 1-5"
            ]
          ],
          "title": "Cronexpressions"
        },
        "cronDescription": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable description of the custom schedule. Required when frequency=custom.",
          "examples": [
            "Weekdays at 9am"
          ],
          "title": "Crondescription"
        }
      },
      "required": [
        "frequency",
        "timezone"
      ],
      "title": "WorkflowTriggerScheduleResponseDto",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "description": "Numeric workflow id (stable per-org; not reused after delete).",
      "examples": [
        42
      ],
      "title": "Id",
      "type": "number"
    },
    "slug": {
      "description": "URL-safe slug used in human-readable links. Unique per org.",
      "examples": [
        "customer-churn-agent-a3f"
      ],
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "description": "Display name of the workflow. Shown in the builder and in run logs.",
      "examples": [
        "Customer Churn Analyzer"
      ],
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional one-paragraph description of what this workflow does.",
      "examples": [
        "Predicts churn risk for a customer given a 90-day usage window."
      ],
      "title": "Description"
    },
    "status": {
      "$ref": "#/$defs/ResourceLifecycleStatus",
      "description": "Lifecycle status. `draft` = never deployed. `active` = deployed. `deleted` = soft-deleted.",
      "examples": [
        "active"
      ]
    },
    "type": {
      "$ref": "#/$defs/AgentType",
      "description": "Type of workflow. `task` = single-step scope orchestration; `workflow` = multi-step graph.",
      "examples": [
        "task"
      ]
    },
    "orgUuid": {
      "description": "Org UUID this workflow belongs to. Matches the caller\u2019s principal.",
      "examples": [
        "00000000-0000-0000-0000-000000000001"
      ],
      "title": "Orguuid",
      "type": "string"
    },
    "activeVariationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Active (deployed) variation id. Null until the workflow is first deployed.",
      "examples": [
        "00000000-0000-4000-a000-000000000100"
      ],
      "title": "Activevariationid"
    },
    "draftVariationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Most recent draft variation id. Null when there is no draft pending.",
      "examples": [
        "00000000-0000-4000-a000-000000000101"
      ],
      "title": "Draftvariationid"
    },
    "hasUnpublishedChanges": {
      "description": "True when the draft variation differs from the active variation (deploy would publish changes).",
      "examples": [
        false
      ],
      "title": "Hasunpublishedchanges",
      "type": "boolean"
    },
    "isEnabled": {
      "description": "Whether the workflow\u2019s schedule is currently active. Toggle via the workflow schedule API.",
      "examples": [
        true
      ],
      "title": "Isenabled",
      "type": "boolean"
    },
    "accessConfig": {
      "$ref": "#/$defs/AgentAccessConfigDto",
      "description": "Access configuration \u2014 who in the org can use / manage this workflow."
    },
    "pendingOwnershipTransfer": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingOwnershipTransferDto"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pending ownership transfer awaiting recipient acceptance. Absent when no request is in flight."
    },
    "variation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentVariationDto"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Variation-detail payload (`trigger`, `workflowStructure`, `agentSelection`) for the requested view. Present on detail responses; absent on list rows."
    },
    "createdAt": {
      "description": "Creation timestamp.",
      "examples": [
        "2026-05-01T10:00:00.000Z"
      ],
      "title": "Createdat",
      "type": "string"
    },
    "updatedAt": {
      "description": "Most recent update timestamp.",
      "examples": [
        "2026-05-11T10:00:00.000Z"
      ],
      "title": "Updatedat",
      "type": "string"
    },
    "deletedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Soft-delete timestamp. Null for active workflows.",
      "examples": [
        null
      ],
      "title": "Deletedat"
    },
