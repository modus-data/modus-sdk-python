{
  "description": "A Modus agent (scheduled automation).\n\nAgents run unattended on a schedule or trigger.\n\n``instructions`` and ``guardrails`` are populated on ``client.agents.get(id)``.\n``guardrails`` is also present on list rows. To change configuration, use\n``modus.management.ModusManagement``.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deleted"
      ],
      "title": "Status",
      "type": "string"
    },
    "type": {
      "enum": [
        "task",
        "workflow"
      ],
      "title": "Type",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "hasUnpublishedChanges": {
      "default": false,
      "title": "HasUnpublishedChanges",
      "type": "boolean"
    },
    "isEnabled": {
      "default": false,
      "title": "IsEnabled",
      "type": "boolean"
    },
    "instructions": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instructions"
    },
    "guardrails": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Guardrails",
      "type": "array"
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "status",
    "type"
  ],
  "title": "Agent",
  "type": "object"
}
